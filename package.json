{
  "name": "unified-public-data",
  "version": "1.0.0",
  "description": "GraphQL gateway that aggregates public REST APIs with caching and query cost analysis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:worker": "tsc && cp wrangler.toml dist/",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "deploy:cloudflare": "npm run build:worker && wrangler deploy",
    "deploy:vercel": "vercel --prod",
    "prepare": "npm run build"
  },
  "keywords": [
    "graphql",
    "apollo",
    "rest",
    "gateway",
    "caching",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "dataloader": "^2.2.2",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "graphql-tag": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
